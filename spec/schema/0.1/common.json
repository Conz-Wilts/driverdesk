{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driverdesk.dev/schema/0.1/common.json",
  "title": "DriverDesk 0.1 common definitions",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "reg_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 64
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$",
      "maxLength": 200
    },
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "u24": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uint": {
      "type": "integer",
      "minimum": 0
    },
    "cel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "cel_obj": {
      "type": "object",
      "properties": {
        "cel": {
          "$ref": "#/$defs/cel"
        }
      },
      "required": [
        "cel"
      ],
      "additionalProperties": false
    },
    "int_or_cel": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/cel_obj"
        },
        {
          "$ref": "#/$defs/cel"
        }
      ]
    },
    "parametric_int": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/cel_obj"
        }
      ]
    },
    "scalar": {
      "type": [
        "integer",
        "number",
        "boolean",
        "string"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "UCUM case-sensitive code"
    },
    "scalar_type": {
      "type": "string",
      "pattern": "^(bool|string|bytes|[ui](8|16|24|32|64)(le|be)?|f(32|64)(le|be)?|bits\\([1-9][0-9]?\\))$"
    },
    "field_type": {
      "type": "string",
      "pattern": "^(bool|[ui](8|16|24|32|64)(le|be)?|f(32|64)(le|be)?|bits\\([1-9][0-9]?\\)|bytes(\\(([0-9]+|[a-z][a-z0-9_]*)\\))?|string(\\(([0-9]+|[a-z][a-z0-9_]*)\\))?|[a-z][a-z0-9_]*)$"
    },
    "struct": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/name"
        },
        "additionalProperties": {
          "$ref": "#/$defs/field_type"
        }
      }
    },
    "struct_or_one": {
      "oneOf": [
        {
          "$ref": "#/$defs/struct"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field_type"
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "range_u16": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/u16"
        },
        "max": {
          "$ref": "#/$defs/u16"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "layer": {
      "enum": [
        "description",
        "logic",
        "runtime",
        "transport",
        "surface"
      ]
    }
  }
}
